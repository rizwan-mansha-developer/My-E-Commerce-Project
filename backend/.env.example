# Darling Backend Environment Variables
# Copy to .env and fill in production values

DEBUG=True
SECRET_KEY=change-me-in-production
# Neon PostgreSQL (recommended) — paste URI from console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
# Local sqlite fallback:
# DATABASE_URL=sqlite:///db.sqlite3

REDIS_URL=redis://127.0.0.1:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1
# Payment gateways (production)
PAYMENT_SANDBOX=true
FRONTEND_URL=http://localhost:3000

# Optional seed for first super admin: python manage.py seed_superuser
SUPERUSER_EMAIL=admin@darling.pk
SUPERUSER_PASSWORD=DarlingAdmin123!

# Email (password reset). Default prints to the Django console.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=Darling <noreply@darling.pk>
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=http://localhost:3000/checkout/success
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_RETURN_URL=http://localhost:3000/checkout/success
STRIPE_SECRET_KEY=
STRIPE_SUCCESS_URL=http://localhost:3000/checkout/success

# Media uploads — leave AWS_* empty to store files under backend/media/ (local)
PUBLIC_MEDIA_BASE_URL=http://localhost:8000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
# Optional CDN in front of the bucket (e.g. cdn.darling.pk)
AWS_S3_CUSTOM_DOMAIN=
